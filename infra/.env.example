# Environment variables required for deployment
DEPLOY_ENV="dev|staging|prod"
CDK_DEFAULT_ACCOUNT="123456789012"
CDK_DEFAULT_REGION="us-east-1"

# Optional — provide to deploy the CodePipeline stack
# Get ARN from AWS Console → CodeStar Connections after approving the GitHub connection
CODESTAR_CONNECTION_ARN=""

# ── Scaling configuration ────────────────────────────────────────────────────
# Lambda
LAMBDA_TIMEOUT_SECONDS=30
LAMBDA_MEMORY_MB=256

# ECS Auto Scaling Group (EC2 instances)
ASG_MIN_CAPACITY_DEV=1
ASG_MIN_CAPACITY_PERF=2
ASG_MAX_CAPACITY_DEV=2
ASG_MAX_CAPACITY_PERF=8
EC2_INSTANCE_SIZE_DEV=MICRO
EC2_INSTANCE_SIZE_PERF=MEDIUM

# ECS task scaling
ECS_TASK_MIN_DEV=1
ECS_TASK_MIN_PERF=2
ECS_TASK_MAX_DEV=4
ECS_TASK_MAX_PERF=8

# Gateway container resources
GATEWAY_CONTAINER_CPU=256
GATEWAY_CONTAINER_MEMORY_SOFT_MB=256
GATEWAY_CONTAINER_MEMORY_HARD_MB=512

# ALB scaling thresholds
ALB_SCALE_REQ_LOW=100
ALB_SCALE_REQ_HIGH=200
ALB_SCALE_LATENCY_LOW_S=2
ALB_SCALE_LATENCY_HIGH_S=3

# Aurora PostgreSQL
AURORA_INSTANCE_SIZE=MEDIUM
AURORA_REPLICA_MIN=1
AURORA_REPLICA_MAX=2
AURORA_REPLICA_CPU_TARGET=60
AURORA_BACKUP_RETENTION_DEV=10
AURORA_BACKUP_RETENTION_PERF=30
RDS_PROXY_MAX_CONNECTIONS_PCT=90

# Redis
REDIS_NODE_TYPE=cache.t3.micro